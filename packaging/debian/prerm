#!/bin/sh
set -eu
case "$1" in
  remove|deconfigure)
    if [ -f /var/lib/magicvision/ccid-metadata.json ]; then
      /usr/lib/magicvision/ccid-metadata --restore --state /var/lib/magicvision/ccid-metadata.json
    fi
    ;;
esac
case "$1" in
  remove|upgrade|deconfigure)
    if [ -d '/var/lib/dkms/magicvision/@VERSION@' ]; then
      dkms remove -m magicvision -v '@VERSION@' --all
    fi
    ;;
esac
exit 0
